extends RefCounted
## Three linked memories. Each call returns fresh, mutable chapter data.
## year is a display string; dialogue arrays are explicitly typed as strings.


static func chapter(index: int) -> Dictionary:
	match clampi(index, 0, 2):
		0:
			return _radio()
		1:
			return _clock()
		_:
			return _lantern()


static func _radio() -> Dictionary:
	return {
		"title": "把声音送到灯塔",
		"year": "1986",
		"location": "海风镇 · 渡口与旧灯塔",
		"role": "年轻的林芸",
		"item_intro": "林奶奶留下了一台海风牌收音机。刻度盘上，一小道铅笔印还指着港务台。",
		"intro_lines": _lines([
			"1986 年。你是二十一岁的林芸，正准备乘末班渡船回家。",
			"海雾漫过码头。检票亭外，一个抱着布兔的小女孩还在等人。",
			"先看看新贴的公告。收音机里那阵沙沙声，也许藏着她在等的消息。",
		]),
		"objectives": _lines([
			"查看渡口的停航公告",
			"调准港务频道，帮抱布兔的女孩听到寻人广播",
			"陪女孩到旧灯塔，与来接她的母亲会合",
		]),
		"interactions": _dialogues([
			_lines([
				"停航公告：海面浓雾，末班渡船停航。寻人请到值班亭登记。",
				"林芸：原来不是晚点。这个孩子，已经等了好一会儿。",
				"值班员：替她报过寻人了，可这台收音机只剩杂音。",
			]),
			_lines([
				"女孩：妈妈说来接我。兔子左耳的蓝布都等湿了。",
				"林芸：慢慢拧到这个刻度……听，港务台有声音了。",
				"广播：寻找抱布兔孩子的家长，请到旧灯塔下会合。",
			]),
			_lines([
				"母亲：在这儿。袖口怎么湿了？先把兔子塞进我外套。",
				"女孩：我没有乱跑。是这位姐姐，替我听见了你。",
				"林芸：灯塔一直亮着。下回走散，就在灯下等。",
			]),
		]),
		"outro_lines": _lines([
			"女孩把布兔举过母亲的肩头，那只蓝耳朵替她挥了挥。",
			"你用铅笔记下港务台的刻度。雨天里，总有人还在等一句消息。",
		]),
		"recipient": "林芸 · 海风镇邮亭",
		"delivery_lines": _lines([
			"学徒：林奶奶，收音机修好了。港务台的声音能听清了。",
			"林芸：那个刻度，你也没擦掉。那天的小姑娘，后来守起了渡口。",
			"林芸：这张旧频道卡给你。背面有去灯塔的路，别在岔口拐早了。",
		]),
		"keepsake": "港务台频道卡 · 背面手绘着灯塔小路",
	}


static func _clock() -> Dictionary:
	return {
		"title": "车票背面的七点",
		"year": "1972",
		"location": "海风镇 · 陈家的旧屋",
		"role": "一座黄铜座钟",
		"item_intro": "陈先生送来父亲留下的座钟。底座夹着一张旧车票，折痕正好避开背面的铅笔字。",
		"intro_lines": _lines([
			"1972 年。我站在陈家的木柜上，玻璃映着一碗已经盛好的长寿面。",
			"小陈把生日蜡烛藏在手心。他父亲说好今晚回来。",
			"我走不了路，但我记得。用 Q / E 调节记忆，停在 18:10、18:30、19:00。",
		]),
		"objectives": _lines([
			"调到 18:10，听见孩子对父亲的误会",
			"调到 18:30，发现车票背面的留言",
			"调到 19:00，看见父亲提前赶回",
		]),
		"interactions": _dialogues([
			_lines([
				"我：18:10。他把椅子朝门挪了半寸，又转了回来。",
				"小陈：他连今天几号都忘了吧。面都要坨了。",
				"母亲：先别倒。你爸从镇外回来，还得换一班车。",
			]),
			_lines([
				"我：18:30。风翻过了他父亲出门前压在我底下的旧车票。",
				"票背留言：换早班车，争取七点。小陈生日，记得买糖糕。",
				"小陈：原来他记着……那我再去添一副筷子。",
			]),
			_lines([
				"我：19:00。门闩响了，比他说好的八点早了一小时。",
				"父亲：车停在旧灯塔那头。我抄了近路，糖糕还温着。",
				"小陈：筷子在这儿。面，我刚替你热过。",
			]),
		]),
		"outro_lines": _lines([
			"我没有把这一小时拨快。他自己赶回来了。",
			"此后很多年，小陈都把等人的那副筷子，放在离门最近的一侧。",
		]),
		"recipient": "陈先生 · 灯塔路旧屋",
		"delivery_lines": _lines([
			"学徒：陈先生，钟走准了。那张车票还在底座里。",
			"陈先生：父亲后来总说，是我的钟慢了。我知道，是他那天跑得快。",
			"陈先生：这张车票拓印送你。原件，就让它继续陪着钟。",
		]),
		"keepsake": "车票拓印 · 背面写着“争取七点”",
	}


static func _lantern() -> Dictionary:
	return {
		"title": "这一次，由我等你",
		"year": "1994",
		"location": "海风镇 · 浓雾中的渡口",
		"role": "船长的女儿 · 周小满",
		"item_intro": "周船长送来一盏旧提灯。他想把它交给如今守着渡口的女儿，灯柄还留着她的刻字。",
		"intro_lines": _lines([
			"1994 年。你是十四岁的周小满，父亲的渡船还在浓雾里。",
			"值班员守着港务台，母亲去准备缆绳。你负责把提灯带到渡口标记旁。",
			"父亲每次收船，都会在岸边找那盏灯。今晚轮到你来提。",
		]),
		"objectives": _lines([
			"点亮旧提灯，让灯光稳定下来",
			"找到浓雾里画着两道蓝漆的渡口标记",
			"站在标记旁举灯，引导父亲的渡船靠岸",
		]),
		"interactions": _dialogues([
			_lines([
				"小满：灯芯不能拧得太高。爸爸说，亮得稳比亮得猛有用。",
				"母亲：守在白线里面，我来接缆绳。",
				"小满：嗯。今晚这盏灯，我拿稳。",
			]),
			_lines([
				"小满：两道蓝漆，是爸爸说的那根白桩。找到了。",
				"小满：旧灯塔在身后。把灯举高，船上就能看见这里。",
				"港务台：末班渡船减速入港，请岸边协助确认标记。",
			]),
			_lines([
				"父亲：看见灯了，靠稳了。蓝耳朵兔子的小姑娘，长大了。",
				"小满：八年前，林芸姐姐陪我在灯塔等妈妈。这次换我来接你。",
				"父亲：灯先别熄，后头还有人要上岸。",
			]),
		]),
		"outro_lines": _lines([
			"八年前，你抱着布兔等在灯下。今夜，灯握在你自己手里。",
			"你又把灯举高一点，照着后面乘客脚下的湿木板。",
		]),
		"recipient": "周小满 · 海风渡口值班亭",
		"delivery_lines": _lines([
			"学徒：小满姐，周船长托我把灯送到你这里。",
			"小满：放在值班亭门口吧。现在轮到我接最后一班船了。",
			"小满：这枚蓝兔布扣给你。是照着小时候那只缝的，林芸阿姨认得。",
		]),
		"keepsake": "蓝兔布扣 · 左耳绣着一小块蓝布",
	}


static func _lines(values: Array[String]) -> Array[String]:
	return values


static func _dialogues(values: Array[Array]) -> Array[Array]:
	return values
